{
  "name": "findanything",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "vite",
    "dev:web": "npm run dev --workspace @findanything/web",
    "build": "tsc && vite build",
    "build:web": "npm run build --workspace @findanything/web",
    "start:web": "npm run start --workspace @findanything/web",
    "check": "npm run check:desktop && npm run build:web",
    "check:desktop": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
